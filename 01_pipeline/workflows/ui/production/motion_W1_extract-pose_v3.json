,"links":null},{"localized_name":"fps","name":"fps","type":"FLOAT","links":null},{"localized_name":"bit_depth","name":"bit_depth","type":"COMBO","links":null},{"localized_name":"color_space","name":"color_space","type":"COMBO","links":null}],"properties":{"Node name for S&R":"GetVideoComponents"}},{"id":45,"type":"SaveImage","pos":[2700,780],"size":[270,58],"flags":{},"order":25,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":34},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":35}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"Save original keyframes","properties":{},"widgets_values":["ComfyUI"],"widgets_values_named":{"filename_prefix":"ComfyUI"}},{"id":46,"type":"MarkdownNote","pos":[-520,10],"size":[480,560],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"title":"How to use — W1 v3 (PRODUCTION 1/3)","properties":{},"widgets_values":["## W1 v3 — pose extraction for the catalog\n**Production 1/3.** Run once per pose. Fast (~1 min).\n\n**Fill in (group 1):**\n1. **Pose name** — becomes the catalog folder (e.g. `look-02`, `pozze-turn`).\n2. **Reference video** — one person, full body, static camera.\n3. Clip **start** and **length** in seconds. Default 5.2 s ≈ 124 frames at 24 fps, the length of the final video. If the video ends earlier, the clip is cut at the end.\n\n**Output** in `output/motion/catalog/<pose>/`: `pose_*.mp4` (skeleton without face, with head, 124 frames, 24 fps), `original_*.mp4` (same frames) and 4 thumbnails of each.\n\n**After running:** `python catalog.py pose <pose>` copies it to `input/motion/poses/<pose>/pose.mp4`, which is what W5 reads.\n\nA long video can give several poses: run again with another start and another name."],"widgets_values_named":{"text":"## W1 v3 — pose extraction for the catalog\n**Production 1/3.** Run once per pose. Fast (~1 min).\n\n**Fill in (group 1):**\n1. **Pose name** — becomes the catalog folder (e.g. `look-02`, `pozze-turn`).\n2. **Reference video** — one person, full body, static camera.\n3. Clip **start** and **length** in seconds. Default 5.2 s ≈ 124 frames at 24 fps, the length of the final video. If the video ends earlier, the clip is cut at the end.\n\n**Output** in `output/motion/catalog/<pose>/`: `pose_*.mp4` (skeleton without face, with head, 124 frames, 24 fps), `original_*.mp4` (same frames) and 4 thumbnails of each.\n\n**After running:** `python catalog.py pose <pose>` copies it to `input/motion/poses/<pose>/pose.mp4`, which is what W5 reads.\n\nA long video can give several poses: run again with another start and another name."},"color":"#432","bgcolor":"#653"}],"links":[[1,1,0,2,1,"STRING"],[2,2,0,3,0,"STRING"],[3,2,0,4,0,"STRING"],[4,2,0,5,0,"STRING"],[5,2,0,6,0,"STRING"],[6,10,0,11,0,"VIDEO"],[11,10,0,16,0,"VIDEO"],[12,14,1,16,1,"INT"],[13,15,1,16,2,"INT"],[14,16,0,17,0,"VIDEO"],[15,17,0,18,0,"VIDEO"],[18,20,0,23,0,"MODEL"],[19,20,2,23,1,"VAE"],[20,22,0,23,2,"IMAGE"],[21,23,0,24,0,"POSE_KEYPOINT"],[22,24,0,30,0,"IMAGE"],[25,18,0,32,0,"IMAGE"],[28,30,0,40,0,"VIDEO"],[29,40,0,41,0,"VIDEO"],[30,41,0,42,0,"IMAGE"],[31,5,0,42,1,"STRING"],[32,32,0,43,0,"VIDEO"],[33,43,0,44,0,"VIDEO"],[34,44,0,45,0,"IMAGE"],[35,6,0,45,1,"STRING"],[7,12,0,14,0,"FLOAT"],[8,11,2,14,1,"FLOAT"],[9,13,0,15,0,"FLOAT"],[10,11,2,15,1,"FLOAT"],[16,18,0,21,0,"IMAGE"],[17,21,0,22,0,"IMAGE"],[23,30,0,31,0,"VIDEO"],[24,3,0,31,1,"STRING"],[26,32,0,33,0,"VIDEO"],[27,4,0,33,1,"STRING"]],"groups":[{"id":"#3f789e","title":"1. INPUT — pose name, video and clip in seconds (only edit here)","bounding":[20,10,322.798828125,788],"color":"#3f789e","flags":{}},{"id":"#444","title":"Output folders (automatic)","bounding":[20,890,1320,530],"color":"#3f789e","flags":{}},{"id":"#88A","title":"2. Clip → 124 frames at 24 fps (automatic)","bounding":[500,10,750,670],"color":"#3f789e","flags":{}},{"id":"#a1309b","title":"3. Skeleton — SDPose, NO face, 