downNote","pos":[0,0],"size":[380,520],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"title":"Como usar o W1","properties":{},"widgets_values":["## W1 · Extração de movimento\n\n1. Coloque o vídeo em **input/motion/** e escolha em *Video de movimento*.\n2. Troque o **Nome do movimento** (vira a pasta no catálogo).\n3. *Trecho (frames)*: start_frame e length (24 fps → 120 = 5 s).\n4. Rode.\n\n**Saídas** em output/motion/catalogo/<nome>/\n- pose_*.mp4 → control_video do H3 (W3a)\n- original_*.mp4 → referência p/ comparação (W4)\n- keyframes/pose_* e original_* → 4 poses p/ o W2\n\nObs.: a pose é reduzida p/ 1024 px e encaixada no grid de 32 px (evita altura ímpar no encoder)."],"widgets_values_named":{"text":"## W1 · Extração de movimento\n\n1. Coloque o vídeo em **input/motion/** e escolha em *Video de movimento*.\n2. Troque o **Nome do movimento** (vira a pasta no catálogo).\n3. *Trecho (frames)*: start_frame e length (24 fps → 120 = 5 s).\n4. Rode.\n\n**Saídas** em output/motion/catalogo/<nome>/\n- pose_*.mp4 → control_video do H3 (W3a)\n- original_*.mp4 → referência p/ comparação (W4)\n- keyframes/pose_* e original_* → 4 poses p/ o W2\n\nObs.: a pose é reduzida p/ 1024 px e encaixada no grid de 32 px (evita altura ímpar no encoder)."},"color":"#432","bgcolor":"#653"}],"links":[[1,1,0,2,1,"STRING"],[2,2,0,3,0,"STRING"],[3,2,0,4,0,"STRING"],[4,2,0,5,0,"STRING"],[5,2,0,6,0,"STRING"],[6,10,0,11,0,"VIDEO"],[7,11,0,12,0,"VIDEO"],[9,20,0,22,0,"MODEL"],[10,20,2,22,1,"VAE"],[11,24,0,22,2,"IMAGE"],[12,22,0,23,0,"POSE_KEYPOINT"],[14,23,0,30,0,"IMAGE"],[15,12,2,30,2,"FLOAT"],[20,30,0,40,0,"VIDEO"],[21,40,0,41,0,"VIDEO"],[22,41,0,42,0,"IMAGE"],[23,5,0,42,1,"STRING"],[24,11,0,43,0,"VIDEO"],[25,43,0,44,0,"VIDEO"],[26,44,0,45,0,"IMAGE"],[27,6,0,45,1,"STRING"],[8,12,0,21,0,"IMAGE"],[13,21,0,24,0,"IMAGE"],[16,30,0,31,0,"VIDEO"],[17,3,0,31,1,"STRING"],[18,11,0,32,0,"VIDEO"],[19,4,0,32,1,"STRING"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.7513148009015777,"offset":[3